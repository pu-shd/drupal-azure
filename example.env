# Copy values to your shell environment before running deployment scripts.
# This file is a reference; scripts do not automatically source it.
AZURE_PLATFORM=appservice
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=
AZURE_APP_NAME=
# Optional single-tenant Entra gate. Leave blank for public browsing.
SITE_AUTH_CLIENT_ID=
MYSQL_VERSION=8.4
# App Service only; Container Apps uses a scheduled Job.
DRUPAL_CRON_INTERVAL=3600
# Runtime secrets are generated/stored in Key Vault by deployment tooling.
# Never put production credentials or site data in this repository.

# Local ports can be changed to coexist with other projects.
DRUPAL_HTTP_PORT=8080
DRUPAL_DB_FORWARD_PORT=13306
